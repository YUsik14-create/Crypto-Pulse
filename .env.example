# Режим работы поставщика данных: live (реальные API), mock (офлайн/демо генератор), auto (автоматический fallback при сбоях)
VITE_DATA_MODE=auto

# Базовые URL (опционально для локального проксирования при региональных блокировках)
VITE_COINGECKO_API_URL=https://api.coingecko.com/api/v3
VITE_BINANCE_API_URL=https://api.binance.com/api/v3
VITE_BINANCE_WS_URL=wss://stream.binance.com:9443
VITE_BINANCE_WS_FALLBACK_URL=wss://data-stream.binance.vision
VITE_ALTERNATIVE_API_URL=https://api.alternative.me
